# Server-side only. Never exposed to the browser.
# Leave empty (or unset) to boot in replay mode with no API spend.
ANTHROPIC_API_KEY=

# SQLite file. Locally data/app.db; on Railway a mounted volume at /data/app.db.
DATABASE_PATH=data/app.db

# better-auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# First admin, seeded at boot if no admin exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# The admin console lives at /<ADMIN_PATH_SLUG>; non-admins get a 404.
ADMIN_PATH_SLUG=admin

# Dev only (build steps 2-5 run against this user before auth lands).
DEV_USER_ID=dev-user

# Replay harness
REPLAY_MODE=            # 1 forces replay/scripted providers for everyone
RECORD=                 # 1 records live API streams to fixtures/recorded/*.jsonl

# Monitoring (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
