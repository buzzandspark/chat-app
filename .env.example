# Keep comments on their own lines: Docker's --env-file keeps anything after the `=`, comments included, as the value.

# Server-side only. Never exposed to the browser.
# Leave empty (or unset) to boot in replay mode with no API spend; production also needs REPLAY_MODE=1 for that.
ANTHROPIC_API_KEY=

# SQLite file; unset, it is data/app.db under the working directory. Leave it unset for Docker (see docs/self-host.md).
# DATABASE_PATH=data/app.db

# better-auth. At least 16 characters; production refuses to start without it or with this placeholder.
# Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public base URL of the app; production refuses to start without it.
BETTER_AUTH_URL=http://localhost:3000

# Admin account. At boot, an ADMIN_EMAIL with no account is created as admin with ADMIN_PASSWORD (8+ chars); an existing
# account is promoted to admin. The email is stored lowercased. The password is never updated later, so replace the
# placeholder before first boot; production refuses to start with `change-me` or one shorter than 10 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# The admin console lives at /<ADMIN_PATH_SLUG>; non-admins get a 404.
ADMIN_PATH_SLUG=admin
# All-time USD cap for a new invited user when the admin leaves the cap blank (positive; default 5).
DEFAULT_COST_CAP_USD=5
# All-time USD cap for each guest (an anonymous visitor on Haiku); default 0.10.
# GUEST_COST_CAP_USD=
# USD a day that guests may spend together: those from one address (an IPv4 address or an IPv6 /64;
# default 1), from one IPv6 /48 (default 3), and all guests (default 10).
# GUEST_IP_USD_PER_DAY=
# GUEST_IP48_USD_PER_DAY=
# GUEST_ALL_USD_PER_DAY=
# The longest prompt a guest may send, in tokens; one that may be over it is counted before it is sent (default 60000,
# at most 90000, below Haiku's long-context tier).
# GUEST_MAX_PROMPT_TOKENS=

# The client address for rate limits and guest budgets. TRUSTED_IP_HEADER names a header
# your proxy sets to the one client address (x-real-ip on Railway); unset, the address is the
# X-Forwarded-For entry TRUST_PROXY_HOPS from the right (default 1 in production).
# TRUSTED_IP_HEADER=
# TRUST_PROXY_HOPS=

# The e2e harness only (Playwright, screenshots, the shutdown test set it): E2E=1 skips the login redirect, runs
# cookieless requests as DEV_USER_ID and turns off the sign-in rate limit. Production refuses to start with E2E set
# unless E2E_ALLOW_PRODUCTION=1. Never set either in a deployment.
DEV_USER_ID=dev-user
# E2E=
# E2E_ALLOW_PRODUCTION=

# Replay harness. 1 forces replay/scripted providers for everyone.
REPLAY_MODE=
# 1 records live API streams to fixtures/recorded/*.jsonl.
RECORD=

# Monitoring (optional). Sentry DSN for server-side errors.
SENTRY_DSN=
# Sentry DSN for the browser; baked in at build time.
NEXT_PUBLIC_SENTRY_DSN=
# Plausible analytics domain; baked in at build time.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
